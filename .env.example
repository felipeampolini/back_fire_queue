# --- API ---
PORT=3000
# Porta exposta no seu computador (mude se a 3000 estiver ocupada)
API_HOST_PORT=3000
LOG_LEVEL=info

# --- AWS / SQS ---
AWS_REGION=us-east-1
# Apenas em desenvolvimento: aponta o SDK para o ElasticMQ. Em produção, remova esta linha.
AWS_ENDPOINT_URL=http://elasticmq:9324
# O ElasticMQ aceita qualquer valor. Em produção (EC2) as credenciais vêm da IAM Role.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
