# --- API ---
PORT=
# Chave exigida no header x-api-key (mínimo 16 caracteres). Gere com: make api-key
API_KEY=
# Porta exposta no seu computador (mude se a 3000 estiver ocupada)
API_HOST_PORT=
LOG_LEVEL=

# --- AWS / SQS ---
AWS_REGION=
# Apenas em desenvolvimento: aponta o SDK para o ElasticMQ. Em produção, remova esta linha.
AWS_ENDPOINT_URL=
# Em desenvolvimento o ElasticMQ aceita qualquer valor. Em produção (EC2) as credenciais vêm da IAM Role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_QUEUE_URL=
SQS_DLQ_URL=

# --- Firebase Web (página de teste) ---
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=

# --- Firebase Admin (worker) — SECRETO ---
# Caminho do JSON da Service Account dentro do container (a pasta do projeto é montada em /app)
GOOGLE_APPLICATION_CREDENTIALS=
